# ===== SRMS Drona - Environment Variables =====
# Copy this file to .env for local dev: cp .env.example .env

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Production (set these on Railway) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=drona.up.railway.app
# DJANGO_SECRET_KEY=<random-50-chars>
# DJANGO_SECURE_SSL_REDIRECT=True

# Gemini AI Quiz Generator - REQUIRED for live AI quiz generation
GEMINI_API_KEY=

# Database - Railway provides DATABASE_URL automatically.
# Local dev: omit -> uses SQLite. Or set to a local Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# SMTP Email (for reminder notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=SRMS Drona <no-reply@srms.ac.in>
SRMS_BASE_URL=http://127.0.0.1:8000

# APScheduler reminder email - set SRMS_RUN_SCHEDULER=1 to enable
SRMS_RUN_SCHEDULER=0
SRMS_REMINDER_INTERVAL_HOURS=24
